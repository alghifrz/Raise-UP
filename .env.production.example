# Public hostnames (without https://)
APP_DOMAIN=raiseup.example.com
API_DOMAIN=api.raiseup.example.com
ACME_EMAIL=admin@example.com

# Supabase PostgreSQL session pooler URL
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require

# Backend
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ALLOWED_ORIGINS=https://raiseup.example.com
SHUTDOWN_TIMEOUT_SECONDS=10

# Supabase Storage
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_GALLERY_BUCKET=gallery
SUPABASE_GALLERY_MAX_UPLOAD_BYTES=10485760

# Initial administrator (only used by cmd/seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator
ADMIN_ROLE=SUPER_ADMIN

# Meta WhatsApp Cloud API
WHATSAPP_ENABLED=false
WHATSAPP_BOT_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
