# Application
PORT=8080
DATABASE_URL=postgres://raiseup:raiseup@127.0.0.1:5433/raiseup?sslmode=disable
# Optional override used inside Docker Compose (for example a Supabase pooler URL).
DOCKER_DATABASE_URL=
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_SECONDS=10

# Supabase Storage (server-side only; never expose the service role key to Vite)
SUPABASE_URL=
# Preferred server key (Settings > API Keys > Secret keys).
SUPABASE_SECRET_KEY=
# Legacy fallback; leave empty when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GALLERY_BUCKET=gallery
SUPABASE_GALLERY_MAX_UPLOAD_BYTES=10485760

# Admin seed (used by: cd backend && go run ./cmd/seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
ADMIN_ROLE=SUPER_ADMIN

# WhatsApp Cloud API (Meta)
# Put real values only in .env (never commit tokens).
# Webhook: https://<public-host>/api/v1/webhooks/whatsapp  (field: messages)
#
# Phone Number ID = dari WhatsApp > API Setup > Phone number ID
#   (bukan App ID, bukan WhatsApp Business Account ID)
WHATSAPP_ENABLED=false
# Public chatbot auto-replies (requires WHATSAPP_ENABLED=true)
WHATSAPP_BOT_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_APP_SECRET=

# Docker Compose / PostgreSQL
API_HOST_PORT=8080
POSTGRES_USER=raiseup
POSTGRES_PASSWORD=raiseup
POSTGRES_DB=raiseup
POSTGRES_PORT=5433
